Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     SuperscriptBox["R", "\[Alpha]"], "\[Beta]\[Gamma]\[Delta]"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Gamma]"], 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], "\[Beta]\[Delta]"]}], "-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Delta]"], 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], "\[Beta]\[Gamma]"]}], "+", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Mu]"], "\[Beta]\[Delta]"], 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], "\[Mu]\[Gamma]"]}], "-", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Mu]"], "\[Beta]\[Gamma]"], 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], "\[Mu]\[Delta]"]}]}]}], 
   " ", ")"}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"a3072db8-b443-c44c-9eb4-2cf4d45f82f2"]], \
"Text",
 CellChangeTimes->{{3.9885710061068916`*^9, 3.9885710650872097`*^9}, {
  3.988571130790041*^9, 3.988571380176876*^9}, {3.9885714255011425`*^9, 
  3.988571465376789*^9}, {3.9885716095331287`*^9, 3.9885716162309666`*^9}, {
  3.9885718314584713`*^9, 3.9885720548546906`*^9}},
 TextAlignment->Center,ExpressionUUID->"2ea90fe3-40c3-7a40-9c85-1a6f95fd0827"],

Cell[BoxData[
 RowBox[{"riemann", ":=", 
  RowBox[{"riemann", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"chrissym", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "l"}], "]"}], "]"}], ",", 
         RowBox[{"coord", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"chrissym", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], ",", 
         RowBox[{"coord", "[", 
          RowBox[{"[", "l", "]"}], "]"}]}], "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"chrissym", "[", 
            RowBox[{"[", 
             RowBox[{"s", ",", "j", ",", "l"}], "]"}], "]"}], "*", 
           RowBox[{"chrissym", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "k", ",", "s"}], "]"}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"chrissym", "[", 
            RowBox[{"[", 
             RowBox[{"s", ",", "j", ",", "k"}], "]"}], "]"}], "*", 
           RowBox[{"chrissym", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "l", ",", "s"}], "]"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9885648359509945`*^9, 3.9885648393752537`*^9}, {
  3.988565083949892*^9, 3.9885651918599434`*^9}, {3.988565223194908*^9, 
