Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["R", "\[Alpha]\[Beta]\[Gamma]\[Delta]"], "=", 
   RowBox[{
    SuperscriptBox["g", "\[Sigma]\[Beta]"], 
    SuperscriptBox["g", "\[Theta]\[Gamma]"], 
    SuperscriptBox["g", "\[Mu]\[Delta]"], 
    SubscriptBox[
     SuperscriptBox["R", "\[Alpha]"], "\[Sigma]\[Theta]\[Mu]"], " "}]}], 
  TraditionalForm]],
