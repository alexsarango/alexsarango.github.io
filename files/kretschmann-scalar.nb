Cell[BoxData[
 RowBox[{"conriemannfirstk", ":=", 
  RowBox[{"conriemannfirstk", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"inversemetric", "[", 
          RowBox[{"[", 
           RowBox[{"j", ",", "s"}], "]"}], "]"}], "*", 
         RowBox[{"inversemetric", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "t"}], "]"}], "]"}], "*", 
         RowBox[{"inversemetric", "[", 
          RowBox[{"[", 
           RowBox[{"l", ",", "u"}], "]"}], "]"}], "*", 
         RowBox[{"riemann", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
